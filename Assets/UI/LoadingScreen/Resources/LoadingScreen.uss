:root {
    width: 100%;
    height: 100%;
}

#Background {
    width: 100%;
    height: 100%;
    background-color: black;
}

#LoadingBar {
    top: 50%;
    width: 100%;

    flex-shrink: 1;
    flex-direction: row;

    justify-content: center;
    align-self: center;

    padding: 4px;

    translate: 0 -50% 0;

    opacity: 100;

    transition-property: opacity;
    transition-duration: 1.5s;
    transition-timing-function: ease-in-out;
}

#LoadingBar.hidden {
    opacity: 0;

    transition-property: opacity;
    transition-duration: 1.5s;
    transition-timing-function: ease-in-out;
}

#LoadingPercentageLabel {
    width: 64px;

    color: white;

    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

#LoadingBar_Background {
    top: 50%;

    width: 360px;
    height: 28px;

    border-color: white;
    border-width: 2px;
    border-radius: 2px;

    translate: 0 -50% 0;

    padding: 2px;
}

#LoadingBar_Fill {
    width: 0;

    flex-grow: 1;

    background-color: white;
}